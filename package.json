    "nitro": "latest",
    "prisma": "^7.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "three": "^0.181.2",
